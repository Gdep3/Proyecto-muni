{
  "compilerOptions": {
    "target": "ES2022",                                  /* A qué versión moderna de JS compilar */
    "module": "CommonJS",                                /* Cómo manejar las importaciones */
    "rootDir": "./",                                     /* Dónde está tu código base */
    "esModuleInterop": true,                             /* Evita errores al importar librerías viejas como express */
    "forceConsistentCasingInFileNames": true,            /* Obliga a respetar mayúsculas y minúsculas (ideal para equipos) */
    "strict": true,                                      /* Activa todas las reglas estrictas de TypeScript */
    "skipLibCheck": true                                 /* Acelera el arranque ignorando errores en node_modules */
  }
}